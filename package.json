{
  "name": "cashflow-hook",
  "version": "3.0.0",
  "private": true,
  "description": "CashflowHook v3 — non-custodial cross-margined credit line for an AI agent with three collateral classes",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cashflowhook/web dev",
    "build": "pnpm --filter @cashflowhook/web build",
    "start": "pnpm --filter @cashflowhook/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "mirror:test": "pnpm --filter @cashflowhook/ts-mirror test",
    "goldens": "pnpm --filter @cashflowhook/ts-mirror generate:goldens",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:snapshot": "forge snapshot --root contracts",
    "check:banned": "node scripts/check-banned-words.mjs",
    "check:submission": "node scripts/check-submission.mjs",
    "check": "pnpm check:banned && pnpm typecheck && pnpm test && pnpm contracts:test"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
