# Real, read-only Ondo USDY source on Ethereum mainnet.
RPC_ETH_MAINNET=https://eth.drpc.org
NAV_READ_MODE=ondo-usdy

# Destination chain for CashflowHook's signed records.
# 84532 = Base Sepolia. Leave RPC_BASE_SEPOLIA blank until you have an endpoint.
CHAIN_ID=84532
RPC_BASE_SEPOLIA=
NAV_SIGNAL_ORACLE_ADDR=
NAV_SIGNER_KEY=

# Optional testnet deployment key. Keep actual values only in local .env.
DEPLOYER_KEY=
